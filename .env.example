# ============================================================
# AgriTrack AI — Environment Variables (copy to .env and fill in)
# NEVER commit the real .env file. Only this example is committed.
# ============================================================

# --- Server port ---
PORT=4000

# --- AI provider (choose ONE) ---
# Option A: OpenAI
OPENAI_API_KEY=sk-your-openai-key-here
# Option B: Google Gemini
GEMINI_API_KEY=your-gemini-key-here

# --- Supabase (optional — farm log persistence) ---
# If left empty, the app runs with an in-memory store (data resets on restart).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Weather (Open-Meteo) ---
# Open-Meteo is free and needs NO API key. Leave as default.
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1